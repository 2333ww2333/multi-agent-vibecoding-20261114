# ===== 模型凭证（DeepSeek，OpenAI 兼容协议）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 官方端点可留空（代码默认 https://api.deepseek.com）；
# 用中转/自建网关时填完整 base url，例如 https://your-gateway.example.com/v1
DEEPSEEK_BASE_URL=

# ===== 运行时覆盖（可选，优先级高于 config/default.yaml）=====
# DEEPSEEK_MODEL=deepseek-flash
# MA_MODEL=deepseek-flash
# MA_MAX_TOKENS=8000
# MA_BASE_URL=https://api.deepseek.com
# MA_LOG_LEVEL=INFO
# MA_DAILY_TOKEN_BUDGET=200000000
# MA_OFFLINE=0

# ===== 农业 RAG（可选，详见 README 第 9 节）=====
# 打开后需先构建知识库：scripts/build_kb.py（产物目录默认 ../kb）
# AGRI_KB_ENABLED=1
# 任意非 .json 路径即进入 qa（parquet 问答语料）模式，与 AGRI_KB_DIR 指向同一产物目录
# AGRI_CORPUS_PATH=../kb
# AGRI_KB_DIR=../kb
# bge-small-zh-v1.5 模型目录（相对路径锚定 multi-agent/ 项目根）
# AGRI_EMBEDDING_MODEL_DIR=../models/bge-small-zh-v1.5
# 单轮知识库检索/报告导出上限（防模型循环刷调用，非云端额度）
# AGRI_MAX_SEARCH_PER_TURN=4
# AGRI_MAX_EXPORT_PER_TURN=1
# 默认写到 Desktop/AgriReports；测试/自定义可覆盖
# AGRI_REPORT_DIR=
# AGRI_TOP_K=5
# AGRI_MIN_SCORE=1.0
